# Port the API server listens on (default: 5000)
PORT=5000

# MongoDB connection string (replace with your own)
MONGODB_URI=mongodb://localhost:27017/carebridge

# Secret used to sign JWT tokens (replace with a long random string)
JWT_SECRET=your_jwt_secret_here

# Frontend URL allowed to call this API (used by CORS)
CLIENT_URL=http://localhost:5173
